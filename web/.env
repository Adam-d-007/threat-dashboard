# Public location of the generated data (the data branch). Not a secret.
# Netlify can override it with an environment variable of the same name.
VITE_DATA_BASE_URL=https://raw.githubusercontent.com/Adam-d-007/threat-dashboard/data
# Which files the site reads. Unset: the old pipeline's latest.json. "v2": the rebuilt
# pipeline's files under v2/ (docs/plans/2026-11-12-rebuild-design.md). Uncommenting this line
# is the website's part of the switch-over.
# VITE_DATA_LAYOUT=v2
