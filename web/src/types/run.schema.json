          "enum": [
            "jihadist",
            "right_wing",
            "left_anarchist",
            "ethno_separatist",
            "state_linked",
            "other",
            "unknown"
          ],
          "title": "Ideology",
          "type": "string"
        },
        "severity": {
          "description": "0 not an incident, 1 arrest or disrupted plot, 2 attempted attack, 3 attack without deaths, 4 attack with 1 to 4 deaths, 5 attack with 5 or more deaths",
