    "AnchorReading": {
      "additionalProperties": false,
      "description": "An official threat level read from a government page, or FCDO travel-advice wording.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "country": {
          "description": "ISO 3166-1 alpha-2",
          "title": "Country",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "scale": {
          "description": "Allowed raw values, lowest to highest",
          "items": {
            "type": "string"
          },
          "title": "Scale",
          "type": "array"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Value read from the page, one of scale",
          "title": "Raw"
        },
        "level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "1-based position of raw on scale",
          "title": "Level"
        },
        "normalized": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "(level - 1) / (len(scale) - 1)",
          "title": "Normalized"
        },
        "since": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Date the level was declared, if stated",
          "title": "Since"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last time the value was read successfully",
          "title": "As Of"
        },
        "status": {
          "enum": [
            "ok",
            "stale",
            "failed",
            "disabled"
          ],
          "title": "Status",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "text_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sha1 of the paragraph stating the level, to detect any change in wording",
          "title": "Text Hash"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Other levels in force at the same time, e.g. a higher level for railways only",
          "title": "Detail"
        },
        "manual": {
          "default": false,
          "description": "Typed in by hand from the official page, because the page cannot be read automatically",
          "title": "Manual",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "country",
        "name",
        "url",
        "scale",
        "raw",
        "level",
        "normalized",
        "since",
        "as_of",
        "status",
        "error",
        "text_hash",
        "detail",
        "manual"
      ],
      "title": "AnchorReading",
      "type": "object"
    },
